{
  "name": "laco-family-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:lan": "node scripts/start-lan.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "tsc -p tsconfig.test.json && node --test tests/*.test.cjs",
    "export:check": "expo export --platform android --output-dir .expo-export-check",
    "doctor": "pnpm dlx expo-doctor@latest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "2.112.3",
    "expo": "~57.0.13",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.10",
    "expo-notifications": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.14",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "typescript": "~7.0.2"
  }
}
